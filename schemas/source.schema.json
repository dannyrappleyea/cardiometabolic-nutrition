{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source",
  "type": "object",
  "required": ["id", "title", "year", "type", "tier", "jurisdiction", "identifiers", "status", "topics", "verified", "findings"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "authors": {"type": ["array", "null"], "items": {"type": "string"}},
    "organization": {"type": ["string", "null"]},
    "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
    "publication": {"type": ["string", "null"]},
    "type": {"enum": ["guideline", "systematic-review", "meta-analysis", "scientific-statement", "umbrella-review", "rct", "cohort", "mendelian-randomization", "mechanistic", "regulatory", "drug-label", "database", "expert-explainer", "manufacturer"]},
    "tier": {"enum": ["1", "2", "3", "4", "5", "6", "R", "M"]},
    "jurisdiction": {"enum": ["us-federal", "us-professional", "canada", "uk", "eu", "australia-nz", "who", "international", "other"]},
    "authority": {"type": ["string", "null"]},
    "domains": {"type": "array", "items": {"enum": ["blood-pressure", "glycemia", "lipids", "weight", "kidney", "liver", "general-nutrition", "food-safety", "medicines"]}},
    "edition": {"type": ["string", "null"]},
    "edition_check": {
      "type": ["object", "null"],
      "required": ["date", "searched", "result"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "searched": {"type": "string", "minLength": 3},
        "result": {"enum": ["current", "newer-recorded", "newer-not-recorded", "not-determined"]},
        "newer": {"type": ["string", "null"]},
        "evidence_url": {"type": ["string", "null"], "pattern": "^https?://", "description": "Page that lists the latest edition: for drug labels, the Drugs@FDA application overview or the DailyMed SPL of the label used"},
        "listed_latest": {"type": ["string", "null"], "description": "Latest edition as that page lists it, e.g. 'SUPPL-58 (2026-03-16)' or 'Revised 3/2026'"}
      },
      "additionalProperties": false
    },
    "label_role": {"enum": ["rld", "reference-standard", "manufacturer-site", "repackager", "other", null], "description": "Drug labels only: which copy of the label this is (playbooks/01-discover.md step 4)"},
    "population_limits": {"type": ["array", "null"], "items": {"type": "string"}},
    "identifiers": {
      "type": "object",
      "properties": {
        "doi": {"type": ["string", "null"], "pattern": "^10\\.\\d{4,9}/\\S+$"},
        "pmid": {"type": ["string", "integer", "null"]},
        "url": {"type": ["string", "null"], "pattern": "^https?://"}
      },
      "anyOf": [
        {"properties": {"doi": {"type": "string"}}, "required": ["doi"]},
        {"properties": {"pmid": {"type": ["string", "integer"]}}, "required": ["pmid"]},
        {"properties": {"url": {"type": "string"}}, "required": ["url"]}
      ]
    },
    "status": {"enum": ["decisive", "background", "superseded"]},
    "superseded_by": {"type": ["string", "null"]},
    "topics": {"type": "array", "items": {"type": "string"}},
    "funding_conflicts": {"type": ["string", "null"]},
    "verified": {
      "type": "object",
      "required": ["date", "method"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "method": {"enum": ["fetched-full-text", "fetched-abstract", "resolved-doi", "fetched-landing-page"]},
        "scope": {"enum": ["full", "partial", "section", "abstract", "summary", "landing-page"]},
        "sections_read": {"type": ["string", "null"]},
        "read_via": {"type": ["string", "null"]},
        "by": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "locator"],
        "properties": {
          "claim": {"type": "string", "minLength": 10},
          "locator": {"type": "string", "minLength": 1},
          "population": {"type": ["string", "null"]},
          "grade": {"type": ["string", "null"]}
        }
      }
    },
    "limitations": {"type": ["string", "null"]},
    "reviewer_read": {"type": "boolean"},
    "notes": {"type": ["string", "null"]}
  },
  "if": {"properties": {"status": {"const": "superseded"}}},
  "then": {"required": ["superseded_by"], "properties": {"superseded_by": {"type": "string"}}},
  "additionalProperties": false
}
